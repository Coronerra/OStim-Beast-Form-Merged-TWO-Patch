<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>OStim Beast Form Merged - TWO Patch 0.1</moduleName>
  <requiredInstallFiles>
    <folder source="00 Patch" destination="" priority="0"/>
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Options">
      <optionalFileGroups order="Explicit">
        <group name="Better Facial Animations" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="BFA Heads">
              <description>Only if you use Better Facial Animations. Adds the two brow-raise morphs to TWO's werewolf head expressions. The TRI is a modified copy of TWO's expression TRI (Frosferes), based on MFA morphs by TealEri (aka CinnaMewRoll); only the two brow morphs were added.</description>
              <files>
                <folder source="10 BFA Heads" destination="" priority="0"/>
              </files>
              <typeDescriptor><type name="Optional"/></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
